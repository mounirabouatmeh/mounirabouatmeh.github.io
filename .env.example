# One AI model for the whole session.
CUBERENCE_AI_MODEL=openai/gpt-5.6-luna

# Existing Cuberence Travel API.
CUBERENCE_TRAVEL_API_BASE_URL=https://cuberence-travel-api.vercel.app
CUBERENCE_API_KEY=

# Vercel AI Gateway uses OIDC by default on Vercel deployments.
